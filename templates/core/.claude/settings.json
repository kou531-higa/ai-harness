{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(python3 scripts/check_undecided.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh label create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr checkout:*)",
      "Bash(python3 scripts/review_route.py:*)",
      "Bash(python3 scripts/impact.py:*)",
      "Bash(python3 scripts/check_forbidden.py:*)",
      "Bash(python3 scripts/check_dec_refs.py:*)",
      "Bash(python3 scripts/check_pr_size.py:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform state:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./infra/envs/prod/**)",
      "Write(./infra/envs/prod/**)",
      "Bash(make merge:*)",
      "Bash(python3 scripts/merge_pr.py:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --no-verify:*)",
      "Edit(./scripts/git-hooks/**)",
      "Write(./scripts/git-hooks/**)",
      "Edit(./.claude/forbidden-patterns.json)",
      "Write(./.claude/forbidden-patterns.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-specs-on-stop.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-done-on-stop.py",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
